# FinAgent Platform Environment Variables
# Copy to .env and fill in your values

# App
APP_NAME=FinAgent Platform
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Database
DATABASE_URL=postgresql+asyncpg://finagent:finagent@localhost:5432/finagent
DATABASE_URL_SYNC=postgresql://finagent:finagent@localhost:5432/finagent

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth - JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Auth - LDAP (configure for your org)
LDAP_SERVER=ldap://localhost:389
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=ou=users,dc=company,dc=com
LDAP_USER_SEARCH_FILTER=(uid={username})

# Google ADK / Gemini
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Financial API (set MOCK_MODE=false when connecting real APIs)
MOCK_MODE=true
FINANCIAL_API_BASE_URL=https://api.financial-data.internal
FINANCIAL_WS_URL=wss://ws.financial-data.internal
